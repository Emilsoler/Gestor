{
  "name": "gestor-dev",
  "private": true,
  "type": "module",
  "description": "Herramientas de prueba del gestor (no se publican con la app)",
  "scripts": {
    "stack": "./stack.sh up",
    "test:db": "node --test tests/db.test.mjs",
    "test:app": "node --test tests/app.test.mjs",
    "vendor": "node vendor.mjs",
    "test:chat": "node --test tests/chat.test.mjs",
    "test:oficio": "node --test tests/oficio.test.mjs",
    "test:cobranzas": "node --test tests/cobranzas.test.mjs && node --test tests/cobranzas-app.test.mjs && node --test tests/certificado-app.test.mjs && npm run test:creditos",
    "test:creditos": "node --test tests/creditos.test.mjs && node --test tests/creditos-app.test.mjs",
    "test:prenda": "node --test tests/prenda.test.mjs && node --test tests/prenda-app.test.mjs"
  },
  "devDependencies": {
    "@fontsource/caladea": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@supabase/supabase-js": "2.117.2",
    "pg": "^8.23.1",
    "playwright": "^1.56.0",
    "sharp": "^0.34.5",
    "ws": "^8.22.0"
  }
}
